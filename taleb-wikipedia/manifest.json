{
  "manifest_version": 3,
  "name": "Incerto for Wikipedia",
  "short_name": "Incerto",
  "version": "1.0.0",
  "description": "Typesets Wikipedia like Nassim Taleb's Technical Incerto: Palatino, maroon spaced small caps, Goudy drop caps, yellow callouts.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Incerto typesetting: on (click to toggle)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://*.wikipedia.org/wiki/*", "*://*.wikipedia.org/w/index.php*"],
      "css": ["incerto.css"],
      "js": ["incerto.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["*://*.wikipedia.org/*"]
    }
  ]
}
